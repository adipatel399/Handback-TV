{
  "name": "handback-tv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "tsx server/index.ts",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:ui": "tsx scripts/verify-ui.ts",
    "android:build": "bash scripts/build-android.sh",
    "android:run": "bash scripts/run-android.sh",
    "demo:record": "bash scripts/record-demo.sh",
    "android:setup": "bash scripts/setup-android.sh",
    "test:emulator": "tsx scripts/verify-emulator.ts",
    "demo:walkthrough": "tsx scripts/record-walkthrough.ts",
    "demo:compose": "python3 scripts/compose-demo.py",
    "package:review": "python3 scripts/package-review.py",
    "test:journey-ui": "tsx scripts/verify-journey-ui.ts",
    "test:live": "tsx scripts/smoke-live-journeys.ts",
    "test:live-emulator": "tsx scripts/verify-live-emulator.ts",
    "test:azure": "tsx scripts/verify-azure.ts",
    "test:azure-emulator": "tsx scripts/verify-azure-emulator.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "8.3.5"
  }
}
