HANDBACK_PORT=4310
HANDBACK_HOST=127.0.0.1
HANDBACK_DATA_DIR=.data
# Optional: use a system Chromium instead of Playwright's downloaded browser.
# HANDBACK_BROWSER_EXECUTABLE=/absolute/path/to/chromium
# Local mode needs no AI provider or API key.
# Hosted mode requires BOTH a trusted HTTPS proxy and private owner access.
# HANDBACK_HOST=0.0.0.0
# HANDBACK_PUBLIC_ORIGIN=https://your-preview.example.com
# HANDBACK_PREVIEW_PASSWORD=replace-with-a-random-secret-of-at-least-24-characters
